# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API Keys

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (replaces legacy anon key) - safe for client-side
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secret key (replaces legacy service_role key) - server/seed scripts ONLY
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Public site URL used for absolute redirects (email confirmation links,
# password reset, OAuth callbacks). Must include protocol, no trailing slash.
#   - Local dev:  http://localhost:3000
#   - Production: https://mentor-sync-omega.vercel.app
# On Vercel you can also set NEXT_PUBLIC_VERCEL_URL automatically; this
# variable wins when present.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed script: assign plan to specific accounts (optional)
SEED_MENTOR_EMAIL=mentor@example.com
SEED_MENTEE_EMAIL=mentee@example.com
