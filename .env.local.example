# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API Keys

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (replaces legacy anon key) - safe for client-side
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secret key (replaces legacy service_role key) - server/seed scripts ONLY
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Seed script: assign plan to specific accounts (optional)
SEED_MENTOR_EMAIL=mentor@example.com
SEED_MENTEE_EMAIL=mentee@example.com
